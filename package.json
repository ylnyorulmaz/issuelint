{
  "name": "issuelint",
  "version": "0.2.0-iteration2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "cf deploy",
    "check:worker": "tsc --strict --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --allowImportingTsExtensions --skipLibCheck --lib ES2022,DOM worker/index.ts",
    "test:worker": "node --experimental-strip-types --test test/worker.test.mjs",
    "check": "npm run check:worker && npm run test:worker && npm run test:client && npm run build",
    "test:client": "node --experimental-strip-types --test test/client.test.mjs"
  },
  "dependencies": {
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.15",
    "cf": "^1.0.0-beta.30",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-solid": "^2.11.10"
  }
}
